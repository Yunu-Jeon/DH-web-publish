            sh:minCount 1 ;
            sh:name "원 소장처 링크"@ko ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:string ;
            sh:description "값: 신문 지면 / 사진 / 문서 / 영상"@ko ;
            sh:in ( "신문 지면" "사진" "문서" "영상" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "유형"@ko ;
            sh:path dcterms:type ],
        [ sh:datatype xsd:string ;
            sh:description "\"출처ID:쪽\" 문자열. 문헌 속에 인용된 자료일 때"@ko ;
            sh:minCount 0 ;
            sh:name "근거 출처와 쪽수"@ko ;
            sh:path dia:citation ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "제목"@ko ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "1차 자료는 연도 미상이 많아 선택. 없으면 화면에 '연도 미상'"@ko ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "생산 연도"@ko ;
            sh:path dcterms:date ],
        [ sh:class dia:Scene ;
            sh:description "대상 클래스: dia:Scene; 자료 하나가 여러 장면의 증거가 될 수 있음"@ko ;
            sh:minCount 0 ;
            sh:name "관련 생활 장면"@ko ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:relation ] ;
    sh:targetClass dctype:StillImage .

<https://yunu-jeon.github.io/DH-Korean-Diaspora/ap/shape/dctype-Text> a sh:NodeShape ;
    rdfs:label "자료(문서)"@ko ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "IIIF·재배포 가능 여부 판단의 기준"@ko ;
            sh:maxCount 1 ;
