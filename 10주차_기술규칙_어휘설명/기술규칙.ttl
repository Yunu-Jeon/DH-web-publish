@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dctype: <http://purl.org/dc/dcmitype/> .
@prefix dia: <https://yunu-jeon.github.io/DH-Korean-Diaspora/ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix skosxl: <http://www.w3.org/2008/05/skos-xl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dia:Scene a rdfs:Class ;
    rdfs:label "생활 장면"@ko ;
    rdfs:comment "먹고, 부르고, 일하고, 배우는 생활문화의 한 장면. 사건(Event)이나 개념(Concept) 어느 쪽에도 맞지 않는 서사 단위."@ko .

<https://yunu-jeon.github.io/DH-Korean-Diaspora/ap/shape/bibo-AcademicArticle> a sh:NodeShape ;
    rdfs:label "출처(논문)"@ko ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "수록 학술지·단행본"@ko ;
            sh:path dcterms:isPartOf ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "제목"@ko ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "원문 공개 여부"@ko ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "접근 조건"@ko ;
            sh:path dcterms:accessRights ],
        [ sh:datatype xsd:string ;
            sh:description "URI 문자열"@ko ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "링크"@ko ;
            sh:path bibo:uri ],
        [ sh:datatype xsd:string ;
            sh:description "미확인인 경우가 있음"@ko ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "발행 연도"@ko ;
            sh:path dcterms:date ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:name "저자"@ko ;
            sh:path dcterms:creator ] ;
    sh:targetClass bibo:AcademicArticle .

<https://yunu-jeon.github.io/DH-Korean-Diaspora/ap/shape/bibo-Document> a sh:NodeShape ;
    rdfs:label "출처(기타 문서)"@ko ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "원문 공개 여부"@ko ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "접근 조건"@ko ;
            sh:path dcterms:accessRights ],
        [ sh:datatype xsd:string ;
            sh:description "URI 문자열"@ko ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "링크"@ko ;
            sh:path bibo:uri ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "수록 학술지·단행본"@ko ;
            sh:path dcterms:isPartOf ],
        [ sh:datatype xsd:string ;
            sh:description "미확인인 경우가 있음"@ko ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "발행 연도"@ko ;
            sh:path dcterms:date ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:name "저자"@ko ;
            sh:path dcterms:creator ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "제목"@ko ;
            sh:path dcterms:title ] ;
    sh:targetClass bibo:Document .

<https://yunu-jeon.github.io/DH-Korean-Diaspora/ap/shape/bibo-Thesis> a sh:NodeShape ;
    rdfs:label "출처(학위논문)"@ko ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:name "저자"@ko ;
            sh:path dcterms:creator ],
        [ sh:datatype xsd:string ;
            sh:description "URI 문자열"@ko ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "링크"@ko ;
            sh:path bibo:uri ],
        [ sh:datatype xsd:string ;
            sh:description "원문 공개 여부"@ko ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "접근 조건"@ko ;
            sh:path dcterms:accessRights ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "제목"@ko ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "미확인인 경우가 있음"@ko ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "발행 연도"@ko ;
            sh:path dcterms:date ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "수록 학술지·단행본"@ko ;
            sh:path dcterms:isPartOf ] ;
    sh:targetClass bibo:Thesis .

<https://yunu-jeon.github.io/DH-Korean-Diaspora/ap/shape/dcterms-Location> a sh:NodeShape ;
    rdfs:label "장소"@ko ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "AP의 '(Mapping 모듈) 좌표'. geo:lon 이 아님"@ko ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "경도"@ko ;
            sh:path geo:long ],
        [ sh:description "그라운딩 대상"@ko ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "외부 전거(GeoNames/Wikidata)"@ko ;
            sh:nodeKind sh:IRI ;
            sh:path skos:exactMatch ],
        [ sh:datatype xsd:string ;
            sh:description "AP의 '(Mapping 모듈) 좌표'. 십진 문자열"@ko ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "위도"@ko ;
            sh:path geo:lat ],
        [ sh:class dcterms:Location ;
            sh:description "대상 클래스: dcterms:Location; 계층 확장 검색용"@ko ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "상위 장소"@ko ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:isPartOf ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "이름"@ko ;
            sh:path dcterms:title ] ;
    sh:targetClass dcterms:Location .

<https://yunu-jeon.github.io/DH-Korean-Diaspora/ap/shape/dctype-MovingImage> a sh:NodeShape ;
    rdfs:label "자료(영상)"@ko ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "값: 신문 지면 / 사진 / 문서 / 영상"@ko ;
            sh:in ( "신문 지면" "사진" "문서" "영상" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "유형"@ko ;
            sh:path dcterms:type ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "제목"@ko ;
            sh:path dcterms:title ],
        [ sh:class foaf:Group ;
            sh:description "대상 클래스: foaf:Group"@ko ;
            sh:minCount 1 ;
            sh:name "문화권"@ko ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:spatial ],
        [ sh:datatype xsd:string ;
            sh:description "IIIF·재배포 가능 여부 판단의 기준"@ko ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "이용 조건"@ko ;
            sh:path dcterms:rights ],
        [ sh:datatype xsd:string ;
            sh:description "\"출처ID:쪽\" 문자열. 문헌 속에 인용된 자료일 때"@ko ;
            sh:minCount 0 ;
            sh:name "근거 출처와 쪽수"@ko ;
            sh:path dia:citation ],
        [ sh:datatype xsd:string ;
            sh:description "1차 자료는 연도 미상이 많아 선택. 없으면 화면에 '연도 미상'"@ko ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "생산 연도"@ko ;
            sh:path dcterms:date ],
        [ sh:description "URI"@ko ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "원 소장처 링크"@ko ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:source ],
        [ sh:class dia:Scene ;
            sh:description "대상 클래스: dia:Scene; 자료 하나가 여러 장면의 증거가 될 수 있음"@ko ;
            sh:minCount 0 ;
            sh:name "관련 생활 장면"@ko ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:relation ] ;
    sh:targetClass dctype:MovingImage .

<https://yunu-jeon.github.io/DH-Korean-Diaspora/ap/shape/dctype-StillImage> a sh:NodeShape ;
    rdfs:label "자료(사진·지면)"@ko ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "IIIF·재배포 가능 여부 판단의 기준"@ko ;
