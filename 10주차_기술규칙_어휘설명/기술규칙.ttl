<https://yunu-jeon.github.io/DH-Korean-Diaspora/ap/shape/dia-Scene> a sh:NodeShape ;
    rdfs:label "생활 장면"@ko ;
    sh:property [ sh:description "대상 클래스: dcterms:Location 또는 foaf:Group"@ko ;
            sh:minCount 1 ;
            sh:name "장소·문화권"@ko ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class dcterms:Location ] [ sh:class foaf:Group ] ) ;
            sh:path dcterms:spatial ],
        [ sh:datatype xsd:string ;
            sh:description "값: 먹는 것 / 부르는 것 / 일하는 것 / 배우는 것"@ko ;
            sh:in ( "먹는 것" "부르는 것" "일하는 것" "배우는 것" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "생활문화의 측면"@ko ;
            sh:path dia:aspect ],
        [ sh:class skos:Concept ;
            sh:description "대상 클래스: skos:Concept; '부르는 것' 장면은 가리키는 대상이 없을 수 있음"@ko ;
            sh:minCount 0 ;
            sh:name "다루는 생활 대상"@ko ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:subject ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "시기"@ko ;
            sh:path dcterms:temporal ],
        [ sh:description "대상 클래스: bibo:AcademicArticle 또는 bibo:Thesis 또는 bibo:Document; 근거 없는 장면을 막음"@ko ;
            sh:minCount 1 ;
            sh:name "근거 출처"@ko ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class bibo:AcademicArticle ] [ sh:class bibo:Thesis ] [ sh:class bibo:Document ] ) ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:string ;
            sh:description "\"출처ID:쪽\" 문자열"@ko ;
            sh:minCount 1 ;
            sh:name "근거 쪽수"@ko ;
            sh:path dia:citation ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "장면 제목"@ko ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "원문을 옮기지 않고 바꿔 씀"@ko ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "설명"@ko ;
            sh:path dcterms:description ] ;
    sh:targetClass dia:Scene .

<https://yunu-jeon.github.io/DH-Korean-Diaspora/ap/shape/foaf-Group> a sh:NodeShape ;
    rdfs:label "문화권"@ko ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "이름"@ko ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "이름 외 고유 정보가 있어 클래스로 둠"@ko ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "이동 개요"@ko ;
            sh:path dcterms:description ],
        [ sh:class dcterms:Location ;
            sh:description "대상 클래스: dcterms:Location"@ko ;
            sh:minCount 1 ;
            sh:name "주요 장소"@ko ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:spatial ],
        [ sh:description "대상 클래스: bibo:AcademicArticle 또는 bibo:Thesis 또는 bibo:Document"@ko ;
            sh:minCount 1 ;
            sh:name "근거 출처"@ko ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class bibo:AcademicArticle ] [ sh:class bibo:Thesis ] [ sh:class bibo:Document ] ) ;
            sh:path dcterms:source ] ;
    sh:targetClass foaf:Group .

<https://yunu-jeon.github.io/DH-Korean-Diaspora/ap/shape/skos-Concept> a sh:NodeShape ;
    rdfs:label "생활 대상"@ko ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "설명"@ko ;
            sh:path skos:definition ],
        [ sh:description "대상 클래스: bibo:AcademicArticle 또는 bibo:Thesis 또는 bibo:Document"@ko ;
            sh:minCount 1 ;
            sh:name "근거 출처"@ko ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class bibo:AcademicArticle ] [ sh:class bibo:Thesis ] [ sh:class bibo:Document ] ) ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:string ;
            sh:description "AP 문서는 @ko. 그라운더·스타터킷은 평문을 요구(가이드 §2.4)"@ko ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "대표 이름(한국어)"@ko ;
            sh:path skos:prefLabel ],
        [ sh:datatype xsd:string ;
            sh:description "값: 먹는 것 / 부르는 것 / 일하는 것 / 배우는 것"@ko ;
            sh:in ( "먹는 것" "부르는 것" "일하는 것" "배우는 것" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "생활문화의 측면"@ko ;
            sh:path dia:aspect ],
        [ sh:description "그라운딩 대상"@ko ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "외부 전거(Wikidata)"@ko ;
            sh:nodeKind sh:IRI ;
            sh:path skos:exactMatch ] ;
    sh:targetClass skos:Concept .

<https://yunu-jeon.github.io/DH-Korean-Diaspora/ap/shape/skosxl-Label> a sh:NodeShape ;
    rdfs:label "어휘"@ko ;
    sh:property [ sh:class skos:Concept ;
            sh:description "대상 클래스: skos:Concept; 활동을 가리키는 말(고본질 등)은 비워 두고 dia:gloss 로 뜻을 적음"@ko ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "가리키는 생활 대상"@ko ;
            sh:nodeKind sh:IRI ;
            sh:path dia:denotes ],
        [ sh:description "대상 클래스: bibo:AcademicArticle 또는 bibo:Thesis 또는 bibo:Document"@ko ;
            sh:minCount 1 ;
            sh:name "근거 출처"@ko ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class bibo:AcademicArticle ] [ sh:class bibo:Thesis ] [ sh:class bibo:Document ] ) ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:string ;
            sh:description "ISO 639-3 코드(rus, jpn, eng, kor)"@ko ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "기원 언어"@ko ;
            sh:path dia:sourceLanguage ],
        [ sh:datatype xsd:string ;
            sh:description "보고된 사실과 해석을 분리"@ko ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "어원 설명(연구자 해석)"@ko ;
            sh:path dia:etymologyNote ],
        [ sh:class foaf:Group ;
            sh:description "대상 클래스: foaf:Group"@ko ;
            sh:minCount 1 ;
            sh:name "쓰인 문화권"@ko ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:spatial ],
        [ sh:datatype xsd:string ;
            sh:description "AP 문서는 언어 태그. 그라운더·스타터킷은 평문을 요구(가이드 §2.4)"@ko ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "표기"@ko ;
            sh:path skosxl:literalForm ],
        [ sh:datatype xsd:string ;
            sh:description "Kim Chee / 김치처럼 검색에 필요"@ko ;
            sh:minCount 0 ;
            sh:name "이표기"@ko ;
            sh:path dia:variantForm ],
        [ sh:datatype xsd:string ;
            sh:description "\"출처ID:쪽\" 문자열"@ko ;
            sh:minCount 1 ;
            sh:name "근거 쪽수"@ko ;
            sh:path dia:citation ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "뜻"@ko ;
            sh:path dia:gloss ] ;
    sh:targetClass skosxl:Label .

dia:basis a rdf:Property ;
    rdfs:label "값 종류"@ko ;
    rdfs:comment "값 하나의 성격 — '보고'(문헌이 보고한 사실), '해석'(연구자·큐레이터의 해석), '문헌 외'(문헌에 없어 편집자가 보탠 값, 예: 근사 좌표) 중 하나. 자원 전체가 아니라 값마다 붙이며, Omeka S 에서는 값 주석(value annotation)에 쓴다."@ko ;
    rdfs:range xsd:string .

dia:denotes a rdf:Property ;
    rdfs:label "가리키는 생활 대상"@ko ;
    rdfs:comment "이 말이 가리키는 생활 대상. 말과 대상을 분리하는 핵심 연결이다. '고본질'처럼 사물이 아닌 활동을 가리키는 말이나 호칭은 비워 두고 dia:gloss 로 뜻을 적는다."@ko ;
    rdfs:domain skosxl:Label ;
    rdfs:range skos:Concept .

dia:etymologyNote a rdf:Property ;
    rdfs:label "어원 설명(연구자 해석)"@ko ;
    rdfs:comment "어원에 대한 연구자의 해석. 문헌이 보고한 사실(dia:gloss)과 해석을 분리하려고 따로 둔다."@ko ;
    rdfs:domain skosxl:Label ;
    rdfs:range xsd:string .

dia:gloss a rdf:Property ;
    rdfs:label "뜻"@ko ;
    rdfs:comment "이 말의 뜻. SKOS-XL 에서 이름표는 원래 뜻을 갖지 않지만, 문화권마다 미묘하게 다른 뜻을 담으려고 어휘에 둔다."@ko ;
    rdfs:domain skosxl:Label ;
    rdfs:range xsd:string .

dia:sourceLanguage a rdf:Property ;
    rdfs:label "기원 언어"@ko ;
    rdfs:comment "이 말이 온 언어의 ISO 639-3 코드(rus, jpn, eng, kor). dcterms:language 는 '자원이 쓰인 언어'라 뜻이 달라 따로 둔다."@ko ;
    rdfs:domain skosxl:Label ;
    rdfs:range xsd:string .

dia:variantForm a rdf:Property ;
    rdfs:label "이표기"@ko ;
    rdfs:comment "같은 말의 다른 표기(예: Kim Chee / 김치, Кукси / 국시). 검색에 필요하다. 표기마다 쓰인 시기·매체는 담지 못한다."@ko ;
    rdfs:domain skosxl:Label ;
    rdfs:range xsd:string .

dia:aspect a rdf:Property ;
    rdfs:label "생활문화의 측면"@ko ;
    rdfs:comment "생활문화의 네 측면 중 하나 — 값은 '먹는 것', '부르는 것', '일하는 것', '배우는 것'. 한 장면이 여러 측면에 걸쳐도 대표 측면 하나만 고르며, 그 선택은 큐레이터의 해석이다."@ko ;
    rdfs:range xsd:string .

dia:citation a rdf:Property ;
    rdfs:label "근거 쪽수"@ko ;
    rdfs:comment "근거 출처와 쪽수를 \"출처ID:쪽\" 문자열로 적는다(예: kwon2020:108). 쪽은 PDF 쪽이 아니라 인쇄된 쪽수, 웹 문헌은 절 이름. dcterms:source 는 문헌만 가리키므로 쪽수를 따로 둔다."@ko ;
    rdfs:range xsd:string .

