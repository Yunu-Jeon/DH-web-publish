        "nfm2003:156" .

ric:scene-hawaii-taxi-cart a rico:Activity,
        dia:Scene ;
    dcterms:description "와이키키 인터내셔널 마켓의 카트 100개 정도 가운데 50개 정도를 한인이 운영했다. 1981년 한인 기사 30여 명이 돈을 모아 한인 최초의 택시회사 '로얄택시'를 세웠고, 택시업에는 7–800명 정도가 일한다. 손님 가운데 일본인 관광객이 많아 택시 기사에게 일본어가 필수라고 한다." ;
    dcterms:source ric:ref-nfm2003 ;
    dcterms:spatial ric:group-hawaii,
        ric:place-waikiki ;
    dcterms:temporal "1981년 ~ 2003년" ;
    dcterms:title "카트와 택시, 하와이 한인의 생업" ;
    rdfs:seeAlso <https://yunu-jeon.github.io/DH-Korean-Diaspora/item.html?id=scene:hawaii-taxi-cart> ;
    rico:generalDescription "와이키키 인터내셔널 마켓의 카트 100개 정도 가운데 50개 정도를 한인이 운영했다. 1981년 한인 기사 30여 명이 돈을 모아 한인 최초의 택시회사 '로얄택시'를 세웠고, 택시업에는 7–800명 정도가 일한다. 손님 가운데 일본인 관광객이 많아 택시 기사에게 일본어가 필수라고 한다." ;
    rico:hasActivityType ric:aspect-work ;
    rico:identifier "scene:hawaii-taxi-cart" ;
    rico:isAssociatedWithPlace ric:place-waikiki ;
    rico:isOrWasSubjectOf ric:col-한-뿌리-다른-땅 ;
    rico:isRelatedTo ric:group-hawaii ;
    rico:name "카트와 택시, 하와이 한인의 생업" ;
