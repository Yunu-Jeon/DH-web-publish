ric:label-horumon a skosxl:Label,
        rico:Concept ;
    dcterms:language "ja" ;
    dcterms:source ric:ref-yeon ;
    dcterms:spatial ric:group-zainichi ;
    rdfs:seeAlso <https://yunu-jeon.github.io/DH-Korean-Diaspora/item.html?id=label:horumon> ;
    skos:altLabel "ホルモン焼き",
        "호르몬",
        "호르몬구이",
        "홀몬야끼" ;
    skos:inScheme ric:scheme-words ;
    skos:prefLabel "ホルモン" ;
    skosxl:literalForm "ホルモン" ;
    rico:generalDescription "야키니쿠 요리에서 내장류를 가리키는 말. 내장구이는 'ホルモン焼き(호르몬구이)'." ;
    rico:identifier "label:horumon" ;
    rico:isOrWasSubjectOf ric:col-한-뿌리-다른-땅 ;
    rico:isRelatedTo ric:concept-offal,
        ric:group-zainichi ;
    dia:citation "yeon:23",
        "yeon:27",
        "yeon:28",
        "yeon:29",
        "yeon:32" ;
    dia:denotes ric:concept-offal ;
    dia:etymologyNote "어원은 다툼이 있다. 간사이 방언 '버리는 것(ほうるもん)'설, 독일어 Hormon설, 김시종의 '조선인의 말'설이 있고, 연윤희는 일본에서는 간사이설이 일반적이라고 소개한다." ;
    dia:gloss "야키니쿠 요리에서 내장류를 가리키는 말. 내장구이는 'ホルモン焼き(호르몬구이)'." ;
    dia:sourceLanguage "jpn" ;
    dia:variantForm "ホルモン焼き",
        "호르몬",
        "호르몬구이",
        "홀몬야끼" .

ric:label-jimchi a skosxl:Label,
