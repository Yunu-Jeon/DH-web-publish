    skos:inScheme ric:scheme-words ;
    skos:prefLabel "짐치" ;
    skosxl:literalForm "짐치" ;
    rico:generalDescription "고려인이 양배추로 담근 김치. 배추가 비싸고 양념을 구하기 어려워 전통 김치 대신 담갔다." ;
    rico:identifier "label:jimchi" ;
    rico:isOrWasSubjectOf ric:col-한-뿌리-다른-땅 ;
    rico:isRelatedTo ric:concept-kimchi,
        ric:group-koryo ;
    dia:citation "kwon2020:114" ;
    dia:denotes ric:concept-kimchi ;
    dia:gloss "고려인이 양배추로 담근 김치. 배추가 비싸고 양념을 구하기 어려워 전통 김치 대신 담갔다." ;
    dia:sourceLanguage "kor" ;
    dia:variantForm "чимчхи" .

