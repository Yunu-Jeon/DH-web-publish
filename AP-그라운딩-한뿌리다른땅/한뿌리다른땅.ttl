ric:label-gireumgubi a skosxl:Label,
        rico:Concept ;
    dcterms:language "ko" ;
    dcterms:source ric:ref-kwon2020 ;
    dcterms:spatial ric:group-koryo ;
    rdfs:seeAlso <https://yunu-jeon.github.io/DH-Korean-Diaspora/item.html?id=label:gireumgubi> ;
